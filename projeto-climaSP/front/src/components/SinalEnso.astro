---
/**
 * Card SINAL ENSO — painel de leitura do Pacífico que fica ao lado do texto de
 * boas-vindas. Medidas do Pen: 440px de largura, #0E3A5D, raio 24.
 */
import {
  LEITURAS,
  SINAL_BADGE,
  SINAL_COBERTURA,
  SINAL_PROCEDENCIA,
  SINAL_ROTULO,
  SINAL_SUBTITULO,
} from "../data/sinal";
---

<aside
  class="flex w-full flex-col gap-3 rounded-panel bg-deep p-4 text-on-dark xl:w-[440px] xl:shrink-0 xl:p-5"
  aria-label="Leitura do sinal ENSO"
>
  <div class="flex items-center gap-2">
    <span class="size-2.5 shrink-0 rounded-full bg-data-warm"></span>
    <span class="text-[14px] font-semibold tracking-widest">{SINAL_ROTULO}</span>
    <span
      class="ml-auto rounded-full bg-data-warm px-1.5 py-1.5 text-[11px] font-semibold"
    >
      {SINAL_BADGE}
    </span>
  </div>

  <p class="m-0 text-[15px] font-semibold leading-[1.35]">{SINAL_SUBTITULO}</p>

  {
    LEITURAS.map(({ rotulo, data, valor }) => (
      <div class="flex flex-col gap-1">
        <span class="flex items-baseline justify-between gap-3 text-[12px] leading-[1.3] text-on-dark/75">
          <span>{rotulo}</span>
          <span class="shrink-0">{data}</span>
        </span>
        <span class="font-data text-[24px] font-bold">{valor}</span>
      </div>
    ))
  }

  <div class="h-px w-full bg-on-dark/15"></div>

  <p class="m-0 text-[12px] leading-[1.45] text-on-dark/70">
    {SINAL_PROCEDENCIA}
  </p>

  <p
    class="m-0 rounded-inset bg-on-dark/8 px-2.5 py-2.5 text-[12px] leading-[1.4]"
  >
    {SINAL_COBERTURA}
  </p>
</aside>