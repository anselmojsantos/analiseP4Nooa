---
type Trimestre = {
	temporada: string;
	mes: string;
	valor: number;
	fase: string;
};

type RespostaFastify = {
	success?: boolean;
	data?: {
		Temporada: string;
		RONI_3_4: number;
		Fase: string;
	}[];
};

const API = 'http://127.0.0.1:3000/media-movel-34';

const MES_LABEL: Record<string, string> = {
	MAM: 'abr',
	AMJ: 'mai',
	MJJ: 'jun',
	JJA: 'jul',
	JAS: 'ago',
};

let linhas: RespostaFastify['data'] | null = null;
let ok = false;
try {
	const resposta = await fetch(API, {
		signal: AbortSignal.timeout(5000),
	});
	ok = resposta.ok;
	if (ok) linhas = ((await resposta.json()) as RespostaFastify).data ?? null;
} catch {
	linhas = null;
}

const trimestres: Trimestre[] =
	linhas && linhas.length > 0
		? linhas.map((l) => ({
				temporada: l.Temporada,
				mes: MES_LABEL[l.Temporada] ?? '',
				valor: l.RONI_3_4,
				fase: l.Fase,
			}))
		: [];

const fonte = ok
	? 'Fonte: backend Fastify · banco do projeto'
	: 'Última leitura NOAA — consolidada, não é tempo real';

const medida = ok ? 'RONI/3.4 · média móvel de temporada' : 'ONI · média de 5 meses';

const numero = (valor: number): string =>
	valor.toLocaleString('pt-BR', {
		minimumFractionDigits: 2,
		maximumFractionDigits: 2,
	});

const leituras = [
	{ label: 'Niño 3.4 · semana', date: '12/08/2026', value: '+1,8 °C' },
	{ label: 'Niño 1 + 2 · semana', date: '19/08/2026', value: '+3,2 °C' },
];
---

<section
	class="flex w-full flex-col gap-3 rounded-panel bg-deep p-4 md:p-5"
	aria-labelledby="sinal-enso"
>
	<div class="flex items-center gap-2">
		<span aria-hidden="true" class="size-2.5 rounded-pill bg-data-warm"></span>
		<h2 id="sinal-enso" class="text-[14px] font-semibold text-on-dark">
			SINAL ENSO
		</h2>
		<span
			class="rounded-pill bg-data-warm px-1.5 py-1.5 text-[11px] font-semibold text-on-dark"
		>
			EL NIÑO FORTE · ADVISORY
		</span>
	</div>

	<p class="text-[15px] font-semibold text-on-dark">
		{fonte}
	</p>

	<div class="flex flex-col gap-2.5">
		<div class="flex flex-col gap-1.5">
			<p class="flex items-baseline justify-between gap-2 text-[12px] text-on-dark/72">
				<span>{medida}</span>
				<span class="tabular-nums">3 últimos trimestres</span>
			</p>

			<ul class="grid grid-cols-3 gap-2">
				{
					trimestres.map((t) => (
						<li class="flex flex-col gap-0.5 rounded-inset bg-on-dark/8 px-2 py-1.5">
							<span class="text-[10px] font-semibold tracking-wide text-on-dark/60">
								{t.temporada}
							</span>
							<span class="text-lg font-bold tabular-nums text-on-dark">
								+{numero(t.valor)}
							</span>
							<span class="text-[10px] leading-tight text-on-dark/55">
								{t.mes} · {t.fase}
							</span>
						</li>
					))
				}
			</ul>
		</div>

		{
			leituras.map((r) => (
				<div class="flex flex-col gap-1">
					<p class="flex items-baseline justify-between gap-2 text-[12px] text-on-dark/72">
						<span>{r.label}</span>
						<span class="tabular-nums">{r.date}</span>
					</p>
					<p class="text-2xl font-bold text-on-dark">{r.value}</p>
				</div>
			))
		}
	</div>

	<hr class="border-on-dark/15" />

	<p class="text-[12px] leading-relaxed text-on-dark/70">
		Base coletada no banco do projeto: 07/01 a 19/08/2026 (33 semanas). O NOAA atualiza
		as séries de TSM toda semana; a diagnose mensal sai na 2ª quinta-feira (a próxima:
		10/09/2026).
	</p>

	<p class="rounded-inset bg-on-dark/8 p-2.5 text-[12px] leading-relaxed text-on-dark">
		87,9% das semanas coletadas com TSM acima da média climatológica na região Niño 1+2
		(0–10°S, 90–80°W).
	</p>
</section>