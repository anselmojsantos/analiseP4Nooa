---
import NavItem from './NavItem.astro';

interface Props {
	current: string;
}

const { current } = Astro.props;

const items = [
	{ label: 'Boas Vindas', href: '/' },
	{ label: 'Visão Geral', href: '/visao-geral' },
	{ label: 'Mapa de SP', href: '/mapa' },
	{ label: 'Séries temporais', href: '/series' },
	{ label: 'Correlações', href: '/correlacoes' },
	{ label: 'Predições', href: '/predicoes' },
	{ label: 'Alertas', href: '/alertas' },
];
---

<aside
	id="nav"
	data-open="false"
	class="nav-drawer fixed inset-y-0 left-0 z-40 flex w-[280px] flex-col gap-6 overflow-y-auto overscroll-contain bg-deep p-5 pb-[calc(env(safe-area-inset-bottom)+1.25rem)] transition-transform duration-[350ms] ease-[cubic-bezier(0.22,0.61,0.36,1)] md:static md:w-[220px] md:overflow-y-auto"
>
	<div class="flex items-center justify-between">
		<a href="/" class="text-lg font-bold text-on-dark">ClimaSP</a>

		<button
			id="nav-close"
			type="button"
			class="-mr-1 grid size-11 place-items-center rounded-pill text-on-dark hover:bg-sidebar-active md:hidden"
		>
			<span class="sr-only">Fechar menu</span>
			<svg
				width="20"
				height="20"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				aria-hidden="true"
			>
				<path d="M18 6 6 18M6 6l12 12"></path>
			</svg>
		</button>
	</div>

	<p class="text-[13px] text-sidebar-soft">PLATAFORMA DE DADOS · CAPITAL</p>

	<nav class="flex flex-col gap-1.5" aria-label="Navegação principal">
		{
			items.map((item) => (
				<NavItem {...item} active={item.href === current} />
			))
		}
	</nav>

	<p class="font-data text-[11px] text-sidebar-soft">
		INMET • NOAA • ANA • CEMADEN
	</p>
</aside>

<style is:global>
	.nav-drawer {
		translate: 0px 0px;
	}

	@media (width < 768px) {
		.nav-drawer {
			translate: -100% 0px;
		}

		.nav-drawer[data-open='true'] {
			translate: 0px 0px;
		}

		.nav-drawer > * {
			opacity: 0;
			transform: translateX(14px);
			transition:
				opacity 0.22s ease,
				transform 0.22s ease;
		}

		.nav-drawer[data-open='true'] > * {
			opacity: 1;
			transform: none;
		}

		.nav-drawer[data-open='true'] > *:nth-child(1) {
			transition-delay: 60ms;
		}
		.nav-drawer[data-open='true'] > *:nth-child(2) {
			transition-delay: 100ms;
		}
		.nav-drawer[data-open='true'] > *:nth-child(3) {
			transition-delay: 140ms;
		}
		.nav-drawer[data-open='true'] > *:nth-child(4) {
			transition-delay: 180ms;
		}

		.nav-drawer[data-open='true'] .nav-drawer-item:nth-child(1) {
			transition-delay: 120ms;
		}
		.nav-drawer[data-open='true'] .nav-drawer-item:nth-child(2) {
			transition-delay: 150ms;
		}
		.nav-drawer[data-open='true'] .nav-drawer-item:nth-child(3) {
			transition-delay: 180ms;
		}
		.nav-drawer[data-open='true'] .nav-drawer-item:nth-child(4) {
			transition-delay: 210ms;
		}
		.nav-drawer[data-open='true'] .nav-drawer-item:nth-child(5) {
			transition-delay: 240ms;
		}
		.nav-drawer[data-open='true'] .nav-drawer-item:nth-child(6) {
			transition-delay: 270ms;
		}
		.nav-drawer[data-open='true'] .nav-drawer-item:nth-child(7) {
			transition-delay: 300ms;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.nav-drawer {
			transition-duration: 120ms;
		}

		.nav-drawer > *,
		.nav-drawer[data-open='true'] > * {
			transform: none;
			transition-duration: 100ms;
			transition-delay: 0ms;
		}
	}
</style>
