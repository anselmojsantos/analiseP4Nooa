---
interface Props {
	label: string;
	href: string;
	active?: boolean;
}

const { label, href, active = false } = Astro.props;
---

<a
	href={href}
	aria-current={active ? 'page' : undefined}
	class:list={[
		'nav-drawer-item flex h-11 items-center gap-2.5 px-2.5 transition-colors',
		'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
		'md:h-[38px]',
		active
			? 'bg-sidebar-active text-on-dark'
			: 'text-sidebar-label hover:bg-sidebar-active/50 hover:text-on-dark',
	]}
>
	<span
		aria-hidden="true"
		class:list={[
			'size-2 shrink-0 rounded-pill',
			active ? 'bg-accent' : 'bg-sidebar-dot',
		]}
	></span>
	<span class="text-[15px] leading-none">{label}</span>
</a>
