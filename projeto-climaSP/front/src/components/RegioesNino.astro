---
/**
 * Seção "Onde o NOAA mede o El Niño": as quatro caixas do Pacífico equatorial.
 *
 * Tabela real com th[scope] — a leitura por leitor de tela depende disso, e o
 * Pen trata as células como colunas de dado, não como um grid decorativo.
 * A linha `guia` (Niño 1+2) sai invertida em azul-marinho.
 */
import {
  ARTE_REGIOES,
  LEGENDA_REGIOES,
  NOTA_REGIOES,
  REGIOES_NINO,
} from "../data/regioes";

const COLUNAS = [
  { titulo: "Região", largura: "w-[80px]" },
  { titulo: "Localização", largura: "w-[236px]" },
  { titulo: "Semanas quentes *", largura: "w-[110px]" },
  { titulo: "Última coleta", largura: "w-[110px]" },
] as const;

const ultima = REGIOES_NINO.length - 1;
---

<section aria-labelledby="regioes-nino">
  <h2 id="regioes-nino" class="m-0 text-[20px] leading-[1.2] font-semibold">
    Onde o NOAA mede o El Niño
  </h2>
  <p class="mt-1.5 mb-0 text-[15px] leading-[1.3] text-ink-secondary">
    As quatro caixas do Pacífico equatorial (regiões Niño) usadas no diagnóstico
    ENSO — a variável-guia do estudo.
  </p>

  <div class="mt-5 grid items-start gap-4 xl:grid-cols-[400px_1fr] xl:gap-5">
    <figure class="m-0 flex flex-col gap-2 rounded-2xl bg-soft p-4">
      <div
        class="grid aspect-[368/226] w-full place-items-center rounded-lg border border-dashed border-data-neutral/40 bg-bg px-3 text-center text-[12px] leading-[1.4] text-data-neutral"
      >
        <span>
          mapa do Pacífico<br />
          <span class="font-data">{ARTE_REGIOES}</span>
        </span>
      </div>
      <figcaption class="text-[11px] leading-[1.4] text-data-neutral">
        {LEGENDA_REGIOES}
      </figcaption>
    </figure>

    <div class="overflow-x-auto">
    <table
      class="w-max min-w-full border-separate border-spacing-x-0 border-spacing-y-1.5 text-left"
    >
      <thead>
        <tr>
        {
          COLUNAS.map(({ titulo, largura }, i) => (
            <th
              scope="col"
              class:list={[
                largura,
                "bg-deep px-2.5 py-2.5 text-[12px] font-semibold text-on-dark",
                i === 0 && "rounded-tl-[10px]",
                i === COLUNAS.length - 1 && "rounded-tr-[10px]",
              ]}
            >
              {titulo}
            </th>
          ))
        }
        </tr>
      </thead>

      <tbody>
        {
          REGIOES_NINO.map(
            ({ regiao, localizacao, semanasQuentes, anomalia, guia }, indice) => (
              <tr class:list={[guia ? "text-on-dark" : "text-ink"]}>
                <th
                  scope="row"
                  class:list={[
                    COLUNAS[0].largura,
                    "px-2.5 py-2.5 text-[14px] font-semibold",
                    guia ? "bg-deep" : indice % 2 === 0 ? "bg-bg" : "bg-soft",
                    indice === 0 && "rounded-tl-[10px]",
                    indice === ultima && "rounded-bl-[10px]",
                  ]}
                >
                  {regiao}
                </th>
                <td
                  class:list={[
                    COLUNAS[1].largura,
                    "px-2.5 py-2.5 text-[14px]",
                    guia
                      ? "bg-deep text-on-dark/85"
                      : indice % 2 === 0
                        ? "bg-bg text-ink-secondary"
                        : "bg-soft text-ink-secondary",
                    indice === ultima && "rounded-bl-[10px]",
                  ]}
                >
                  {localizacao}
                </td>
                <td
                  class:list={[
                    COLUNAS[2].largura,
                    "px-2.5 py-2.5 font-data text-[14px]",
                    guia ? "bg-deep" : indice % 2 === 0 ? "bg-bg" : "bg-soft",
                    indice === ultima && "rounded-bl-[10px]",
                  ]}
                >
                  {semanasQuentes}
                </td>
                <td
                  class:list={[
                    COLUNAS[3].largura,
                    "px-2.5 py-2.5 font-data text-[14px] font-bold",
                    guia ? "bg-deep text-amber" : "text-data-warm",
                    indice % 2 === 0 ? "bg-bg" : "bg-soft",
                    indice === ultima && "rounded-br-[10px]",
                  ]}
                >
                  {anomalia}
                </td>
              </tr>
            ),
          )
        }
      </tbody>
    </table>
    </div>
  </div>

  <p
    class="mt-3.5 mb-0 max-w-[70ch] text-[12px] leading-[1.5] text-data-neutral"
  >
    {NOTA_REGIOES}
  </p>
</section>